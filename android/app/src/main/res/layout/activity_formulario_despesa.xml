<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="48dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adicionar Despesa"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etCategoriaDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Categoria"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etTipoDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tipo"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etNomeDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome da despesa"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etDescricaoDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descrição"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etValorUnitarioDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor unitário"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etQuantidadeDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantidade"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etValorOrcadoDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Valor orçado"
        android:inputType="numberDecimal"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnCadastrarDespesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cadastrar despesa" />

</LinearLayout>